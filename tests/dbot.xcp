fn ping_text(ping) {
  return "🏓 Pong!\nPing: " + ping
}

fn on_message(content, channel, ping) {
  if (starts_with(content, ",ping")) {
    discord_send(token, channel, ping_text(ping))
  }
}

fn on_slash_command(command, channel, interaction_id, interaction_token, ping) {
  if (command == "/ping") {
    discord_interaction_reply(token, interaction_id, interaction_token, ping_text(ping))
  }
}

let application_id = ""
let guild_id = ""
let slash_name = "ping"
let slash_description = "show ping"

fn register_commands() {
  if (token != "" && application_id != "" && guild_id != "") {
    discord_register_slashcommand(token, application_id, guild_id, slash_name, slash_description)
  }
}

let token = run_bash("printf '%s' \"$XCP_DISCORD_TOKEN\"")
